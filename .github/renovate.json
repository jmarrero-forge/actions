{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cgwalters-forge/actions//renovate/runners"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/cgwalters-review\\.yml$/"],
      "matchStrings": ["uses: jmarrero-forge/actions/(?:admit|deployment|tailscale)@(?<currentDigest>[0-9a-f]{40}) # main"],
      "currentValueTemplate": "main",
      "depNameTemplate": "review-actions",
      "packageNameTemplate": "https://github.com/jmarrero-forge/actions",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Update the review wrapper's own-action commits together through review, even without release tags",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["https://github.com/jmarrero-forge/actions"],
      "enabled": true,
      "groupName": "review actions",
      "automerge": false
    }
  ]
}
